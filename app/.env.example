APP_SECRET=               # Secret used to sign Sakay Naga session cookies
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)
ADMIN_EMAIL=              # Optional first-party email that becomes admin on registration
TRUST_PROXY=              # Optional: "cloudflare" or "true" (one reverse proxy). Unset = ignore X-Forwarded-For/X-Real-IP for rate limiting
SESSION_COOKIE_SAMESITE=  # Optional: set to "none" only if the web app is served cross-site from the API (default Lax)
